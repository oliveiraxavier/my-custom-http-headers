{
    "manifest_version": 3,
    "name": "My Custom HTTP Headers",
    "version": "1.0.1",
    "description": "Teste seus sites com headers HTTP personalizados.",
    "homepage_url": "https://github.com/oliveiraxavier/my-custom-http-headers",
    "icons": {
        "48": "icons/48.png",
        "96": "icons/96.png"
    },
    "permissions": [
        "activeTab",
        "storage",
        "declarativeNetRequest"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "icons/icon-default.png",
            "96": "icons/icon-default.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}